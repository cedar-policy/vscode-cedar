{
  "name": "vscode-cedar",
  "displayName": "Cedar",
  "description": "Cedar policy language support - syntax highlighting, formatting, and validation",
  "publisher": "cedar-policy",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cedar-policy/vscode-cedar.git"
  },
  "bugs": {
    "url": "https://github.com/cedar-policy/vscode-cedar/issues"
  },
  "qna": "https://github.com/cedar-policy/vscode-cedar/issues",
  "version": "0.12.0",
  "preview": true,
  "icon": "icons/cedar-policy.png",
  "engines": {
    "vscode": "^1.83.0",
    "node": ">=18.0.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "Cedar"
  ],
  "activationEvents": [
    "workspaceContains:**/*.cedar",
    "workspaceContains:**/*.cedar.json",
    "workspaceContains:**/cedarschema",
    "workspaceContains:**/*.cedarschema",
    "workspaceContains:**/*.cedarschema.json",
    "workspaceContains:**/cedarschema.json",
    "workspaceContains:**/*.cedarentities.json",
    "workspaceContains:**/cedarentities.json",
    "workspaceContains:**/*.cedartests.json",
    "workspaceContains:**/cedartests.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "cedar",
        "aliases": [
          "Cedar",
          "cedar"
        ],
        "extensions": [
          ".cedar"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/Cedar_16.svg",
          "dark": "./icons/Cedar_16.svg"
        }
      },
      {
        "id": "cedar-injection"
      },
      {
        "id": "cedarschema",
        "aliases": [
          "Cedar Schema",
          "cedar schema"
        ],
        "extensions": [
          ".cedarschema"
        ],
        "filenames": [
          "cedarschema"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/CedarSchema_16.svg",
          "dark": "./icons/CedarSchema_16.svg"
        }
      },
      {
        "id": "cedarschema-injection"
      }
    ],
    "commands": [
      {
        "command": "cedar.validate",
        "category": "Cedar",
        "title": "Validate Cedar policy"
      },
      {
        "command": "cedar.activate",
        "category": "Cedar",
        "title": "Activate Cedar extension"
      },
      {
        "command": "cedar.about",
        "category": "Cedar",
        "title": "About Cedar extension"
      },
      {
        "command": "cedar.documentation",
        "category": "Cedar",
        "title": "Open docs.cedarpolicy.com"
      },
      {
        "command": "cedar.export",
        "category": "Cedar",
        "title": "Export Cedar policy as JSON"
      },
      {
        "command": "cedar.jsonpreview",
        "category": "Cedar",
        "title": "JSON"
      },
      {
        "command": "cedar.schemavalidate",
        "category": "Cedar",
        "title": "Validate Cedar schema"
      },
      {
        "command": "cedar.schematranslate",
        "category": "Cedar",
        "title": "Translate Cedar schema"
      },
      {
        "command": "cedar.schemaexport",
        "category": "Cedar",
        "title": "Export Cedar schema"
      },
      {
        "command": "cedar.schemaopen",
        "category": "Cedar",
        "title": "Open Cedar schema"
      },
      {
        "command": "cedar.entitiesvalidate",
        "category": "Cedar",
        "title": "Validate Cedar entities"
      },
      {
        "command": "cedar.entitiesadd",
        "category": "Cedar",
        "title": "Add Cedar entity"
      },
      {
        "command": "cedar.testsvalidate",
        "category": "Cedar",
        "title": "Validate Cedar tests"
      },
      {
        "command": "cedar.testsadd",
        "category": "Cedar",
        "title": "Add Cedar test"
      },
      {
        "command": "cedar.clearproblems",
        "category": "Cedar",
        "title": "Clear problems"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "when": "resourceScheme == file && (editorLangId == cedarschema || editorLangId == cedar)",
          "command": "cedar.jsonpreview",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId == cedar",
          "command": "cedar.validate",
          "group": "1_modification"
        },
        {
          "when": "resourceScheme == file && editorLangId == cedar",
          "command": "cedar.export",
          "group": "y_commands"
        },
        {
          "when": "editorLangId == cedar || cedar.entitiesFile || cedar.avpEntitiesFile || cedar.testsFile",
          "command": "cedar.schemaopen",
          "group": "navigation"
        },
        {
          "when": "resourceScheme == file && (editorLangId == cedarschema || cedar.schemaJsonFile)",
          "command": "cedar.schemavalidate",
          "group": "1_modification"
        },
        {
          "when": "resourceScheme == file && (editorLangId == cedarschema || cedar.schemaJsonFile)",
          "command": "cedar.schematranslate",
          "group": "1_modification"
        },
        {
          "when": "resourceScheme == file && cedar.schemaJsonFile",
          "command": "cedar.schemaexport",
          "group": "y_commands"
        },
        {
          "when": "cedar.entitiesFile",
          "command": "cedar.entitiesvalidate",
          "group": "1_modification"
        },
        {
          "when": "cedar.entitiesFile",
          "command": "cedar.entitiesadd",
          "group": "1_modification"
        },
        {
          "when": "cedar.testsFile",
          "command": "cedar.testsvalidate",
          "group": "1_modification"
        },
        {
          "when": "cedar.testsFile",
          "command": "cedar.testsadd",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "cedar.activate",
          "when": "!cedar.activated"
        },
        {
          "command": "cedar.validate",
          "when": "editorLangId == cedar"
        },
        {
          "command": "cedar.export",
          "when": "resourceScheme == file && editorLangId == cedar"
        },
        {
          "command": "cedar.schemavalidate",
          "when": "editorLangId == cedarschema || editorLangId == json"
        },
        {
          "command": "cedar.schematranslate",
          "when": "resourceScheme == file && (editorLangId == cedarschema || cedar.schemaJsonFile)"
        },
        {
          "command": "cedar.schemaexport",
          "when": "resourceScheme == file && cedar.schemaJsonFile"
        },
        {
          "command": "cedar.entitiesvalidate",
          "when": "editorLangId == json"
        },
        {
          "command": "cedar.entitiesadd",
          "when": "cedar.entitiesFile"
        },
        {
          "command": "cedar.testsvalidate",
          "when": "editorLangId == json"
        },
        {
          "command": "cedar.testsadd",
          "when": "cedar.testsFile"
        }
      ]
    },
    "grammars": [
      {
        "language": "cedar",
        "scopeName": "source.cedar",
        "path": "./syntaxes/cedar.tmLanguage.json"
      },
      {
        "language": "cedar-injection",
        "scopeName": "markdown.cedar.codeblock",
        "path": "./syntaxes/codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.cedar": "cedar"
        }
      },
      {
        "language": "cedarschema",
        "scopeName": "source.cedarschema",
        "path": "./syntaxes/cedarschema.tmLanguage.json"
      },
      {
        "language": "cedarschema-injection",
        "scopeName": "markdown.cedarschema.codeblock",
        "path": "./syntaxes/codeblock.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.cedarschema": "cedarschema"
        }
      }
    ],
    "configuration": {
      "title": "Cedar",
      "properties": {
        "cedar.schemaFile": {
          "type": "string",
          "default": null,
          "description": "Location of Cedar schema file used for policy validation."
        },
        "cedar.autodetectSchemaFile": {
          "type": "boolean",
          "default": true,
          "description": "Auto detect Cedar schema file used for policy validation."
        },
        "cedar.fileAssociations": {
          "type": "object",
          "default": {},
          "scope": "resource",
          "description": "Configure glob patterns to treat JSON files which don't follow the Cedar naming convention as Cedar files.",
          "markdownDescription": "Configure glob patterns to treat JSON files which don't follow the Cedar naming convention as Cedar files.  A pattern without a `/` matches that filename in any folder, in the style of `#files.associations#`.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "cedarschema.json",
              "cedarentities",
              "avpentities",
              "cedartemplatelinks",
              "cedarauth",
              "cedartests",
              "cedar.json"
            ],
            "enumDescriptions": [
              "Cedar schema in the JSON format",
              "Cedar entities",
              "Amazon Verified Permissions entities",
              "Cedar template linked policies",
              "Cedar authorization request",
              "Cedar tests",
              "Cedar policies in the JSON format"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint && npm run format:check",
    "lint": "eslint src --ext ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vscode-test",
    "test:file": "vscode-test --files",
    "package": "vsce package --follow-symlinks",
    "package-prerelease": "vsce package --pre-release --follow-symlinks",
    "prewasm-build": "npm run wasm-format:check",
    "wasm-build": "cd vscode-cedar-wasm && wasm-pack build --target nodejs",
    "wasm-format": "cd vscode-cedar-wasm && cargo fmt",
    "wasm-format:check": "cd vscode-cedar-wasm && cargo fmt --check",
    "wasm-test": "cd vscode-cedar-wasm && cargo test --lib",
    "wasm-pkg": "cd vscode-cedar-wasm/pkg && npm pack && mv *.tgz ../..",
    "test:grammar": "npm run compile && mocha --ui tdd out/test/suite/tmgrammar.test.js"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "vscode-cedar-wasm": "file:vscode-cedar-wasm/pkg"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "=18.15.0",
    "@types/vscode": "=1.83.0",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^9.39.5",
    "js-yaml": "^4.3.2",
    "mocha": "^11.8.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "keytar@7.9.0": true,
    "@vscode/vsce-sign@2.1.0": true
  },
  "overrides": {
    "diff": ">=8.0.3",
    "serialize-javascript": ">=7.0.5"
  }
}
