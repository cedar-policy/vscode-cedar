// User is declared external, but no schema file in this folder defines it, so
// the schema is partial: entities validate, while policies can't be validated
// until a linked schema defines User
namespace DocApp {
  external entity User;

  entity Document {
    "owner": User,
    "title": String,
  };

  action view appliesTo {
    principal: [User],
    resource: [Document],
  };
}
